package com.dgsi.maintenance.service;

import java.util.ArrayList;
import java.util.Base64;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

@Service
public class KeycloakService {

    private String authServerUrl = "http://localhost:8080";
    private String realm = "Maintenance-DGSI";
    private String adminUsername = "admin";
    private String adminPassword = "admin123";

    /**
     * Get headers with Basic Auth for admin API calls
     */
    private HttpHeaders getAdminHeaders() {
        HttpHeaders headers = new HttpHeaders();
        String auth = adminUsername + ":" + adminPassword;
        byte[] encodedAuth = Base64.getEncoder().encode(auth.getBytes());
        String authHeader = "Basic " + new String(encodedAuth);
        headers.set("Authorization", authHeader);
        return headers;
    }

    /**
     * Récupère tous les prestataires (utilisateurs avec le rôle PRESTATAIRE) depuis Keycloak
     */
    public List<Map<String, Object>> getAllPrestataires() {
        List<Map<String, Object>> prestataires = new ArrayList<>();
        
        try {
            RestTemplate restTemplate = new RestTemplate();
            
            // Get all users with Basic Auth
            String usersUrl = authServerUrl + "/admin/realms/" + realm + "/users";
            
            HttpHeaders headers = getAdminHeaders();
            HttpEntity<Void> entity = new HttpEntity<>(headers);
            
            ResponseEntity<String> response = restTemplate.exchange(usersUrl, HttpMethod.GET, entity, String.class);
            
            ObjectMapper mapper = new ObjectMapper();
            JsonNode users = mapper.readTree(response.getBody());
            
            // Get the PRESTATAIRE role
            String roleUrl = authServerUrl + "/admin/realms/" + realm + "/roles/PRESTATAIRE";
            ResponseEntity<String> roleResponse = restTemplate.exchange(roleUrl, HttpMethod.GET, entity, String.class);
            JsonNode prestataireRole = mapper.readTree(roleResponse.getBody());
            String roleName = prestataireRole.get("name").asText();
            
            // Filter users with PRESTATAIRE role
            for (JsonNode user : users) {
                String userId = user.get("id").asText();
                
                String userRoleUrl = authServerUrl + "/admin/realms/" + realm + "/users/" + userId + "/role-mappings/realm";
                ResponseEntity<String> userRoleResponse = restTemplate.exchange(userRoleUrl, HttpMethod.GET, entity, String.class);
                JsonNode userRoles = mapper.readTree(userRoleResponse.getBody());
                
                boolean hasPrestataireRole = false;
                for (JsonNode role : userRoles) {
                    if (roleName.equals(role.get("name").asText())) {
                        hasPrestataireRole = true;
                        break;
                    }
                }
                
                if (hasPrestataireRole) {
                    Map<String, Object> prestataire = new HashMap<>();
                    prestataire.put("id", user.get("id").asText());
                    prestataire.put("email", user.has("email") && !user.get("email").isNull() ? user.get("email").asText() : "");
                    String firstName = user.has("firstName") && !user.get("firstName").isNull() ? user.get("firstName").asText() : "";
                    String lastName = user.has("lastName") && !user.get("lastName").isNull() ? user.get("lastName").asText() : "";
                    prestataire.put("nom", firstName + " " + lastName);
                    prestataire.put("firstName", firstName);
                    prestataire.put("lastName", lastName);
                    prestataire.put("username", user.get("username").asText());
                    prestataire.put("enabled", user.get("enabled").asBoolean());
                    prestataires.add(prestataire);
                }
            }
            
            System.out.println("Récupérés " + prestataires.size() + " prestataires depuis Keycloak");
            
        } catch (Exception e) {
            System.err.println("Erreur lors de la récupération des prestataires: " + e.getMessage());
            e.printStackTrace();
            throw new RuntimeException("Erreur de connexion à Keycloak: " + e.getMessage());
        }
        
        return prestataires;
    }

    /**
     * Récupère tous les utilisateurs depuis Keycloak
     */
    public List<Map<String, Object>> getAllUsers() {
        List<Map<String, Object>> users = new ArrayList<>();
        
        try {
            RestTemplate restTemplate = new RestTemplate();
            
            String usersUrl = authServerUrl + "/admin/realms/" + realm + "/users";
            
            HttpHeaders headers = getAdminHeaders();
            HttpEntity<Void> entity = new HttpEntity<>(headers);
            
            ResponseEntity<String> response = restTemplate.exchange(usersUrl, HttpMethod.GET, entity, String.class);
            
            ObjectMapper mapper = new ObjectMapper();
            JsonNode userList = mapper.readTree(response.getBody());
            
            for (JsonNode user : userList) {
                Map<String, Object> userMap = new HashMap<>();
                userMap.put("id", user.get("id").asText());
                userMap.put("email", user.has("email") && !user.get("email").isNull() ? user.get("email").asText() : "");
                String firstName = user.has("firstName") && !user.get("firstName").isNull() ? user.get("firstName").asText() : "";
                String lastName = user.has("lastName") && !user.get("lastName").isNull() ? user.get("lastName").asText() : "";
                userMap.put("nom", firstName + " " + lastName);
                userMap.put("firstName", firstName);
                userMap.put("lastName", lastName);
                userMap.put("username", user.get("username").asText());
                userMap.put("enabled", user.get("enabled").asBoolean());
                users.add(userMap);
            }
            
            System.out.println("Récupérés " + users.size() + " utilisateurs depuis Keycloak");
            
        } catch (Exception e) {
            System.err.println("Erreur lors de la récupération des utilisateurs: " + e.getMessage());
            e.printStackTrace();
            throw new RuntimeException("Erreur de connexion à Keycloak: " + e.getMessage());
        }
        
        return users;
    }
}
